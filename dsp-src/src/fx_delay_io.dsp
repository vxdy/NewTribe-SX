; BPM Delay helper / bus I/O
; IRAM 0x1280..0x1295 (22 words)

.org 0x1280
fx_delay_io:
    dp1 = 0x2410                               ; 1280: 38022410
    clr r0 <- r0                               ; 1281: 61000000
    clr r1 <- r0                               ; 1282: 61040000
    r0l = *dp0++                               ; 1283: 4C821000
    r1l = dp1                                  ; 1284: 3C830000
    r2 = add r0, r1                            ; 1285: 88280000
    dp1 = r2l                                  ; 1286: 3D020000
    r2l = *dp4++                               ; 1287: 4C110012
    *dp1++ = r2l                               ; 1288: 4C805200
    r2l = *dp4++                               ; 1289: 4C110012
    *dp1++ = r2l                               ; 128A: 4C805200
    dp1 = 0x2400                               ; 128B: 38022400
    nop                                        ; 128C: 00000000
    r1l = dp1                                  ; 128D: 3C830000
    r2 = add r0, r1                            ; 128E: 88280000
    dp1 = r2l                                  ; 128F: 3D020000
    nop                                        ; 1290: 00000000
    r2l = *dp1++                               ; 1291: 4C825200
    *dp4++ = r2l                               ; 1292: 4C100012
    r2l = *dp1++                               ; 1293: 4C825200
    *dp4++ = r2l                               ; 1294: 4C100012
    ret                                        ; 1295: 24000000
