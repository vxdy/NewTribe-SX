; Clear FX state & external delay RAM
; IRAM 0x1000..0x1033 (52 words)

.org 0x1000
fx_clear_ext:
    r0l = *dp0##57                             ; 1000: 44110039
    r0l = *dp0++                               ; 1001: 4C821000
    dp2 = r0l                                  ; 1002: 3C040000
    clr r0 <- r0 r1 = *dp4++                   ; 1003: 71010011
    repeat 5                                   ; 1004: 1C000005
    *dp2++ = r0l                               ; 1005: 4C809000
    r0 = *dp0++                                ; 1006: 4F821000
    r1 = mul r1, r0 r2 = *dp4++                ; 1007: 91050012
    r2 = mul r2, r0 *dp4++ = r1h               ; 1008: A1080011
    *dp4 = r2h                                 ; 1009: 4C20000A
    r7l = *dp0++                               ; 100A: 4C821700
    r0 = r7 add 0x2410                         ; 100B: 58E02410
    dp1 = r0l                                  ; 100C: 3C020000
    clr r0 <- r0                               ; 100D: 61000000
    *dp1++ = r0h                               ; 100E: 4D005000
    *dp1++ = r0h                               ; 100F: 4D005000
    r0l = *dp0                                 ; 1010: 4C820800
    clr r1 <- r0                               ; 1011: 61040000
    r1l = dp3                                  ; 1012: 3C870000
    r1 = add r1, r0                            ; 1013: 98040000
    dp3 = r1l                                  ; 1014: 3C860000
    dp7 = r1l                                  ; 1015: 3C8E0000
    clr r1 <- r0                               ; 1016: 61040000
    *dp3 = r1l *dp7 = r1l                      ; 1017: 4C90C9C9
    inc r0 <- r0                               ; 1018: 62000000
    r1 = r0 sub 0x40                           ; 1019: 59040040
    if (r1 ==0) acc+ r0 <- r1                  ; 101A: 6C200011
    *dp0++ = r0l                               ; 101B: 4C801000
    clr r1 <- r0 r7 = *dp0++                   ; 101C: 71061700
    r7l = *dp0++                               ; 101D: 4C821700
    r1l = *dp0                                 ; 101E: 4C820900
    r2 = add r7, r1                            ; 101F: F8280000
    r0l = 0x3f                                 ; 1020: 3801003F
    *x:0x38c1 = r0l                            ; 1021: 481038C1
    clr r3 <- r0                               ; 1022: 610C0000
    loop 6 { end=+12                           ; 1023: 140C0006
    r0 = r2 srl 0xc                            ; 1024: 5E40000C
    r0 = r0 add 0x18                           ; 1025: 58000018
    r0 = r0 and 0x18                           ; 1026: 5A000018
    *x:0x3844 = r0l                            ; 1027: 48103844
    r0 = r2 and 0x7fff                         ; 1028: 5A407FFF
    r0 = r0 add 0x8000                         ; 1029: 58008000
    dp6 = r0l                                  ; 102A: 3C0C0000
    inc r1 <- r1                               ; 102B: 62240000
    *dp6 = r3l                                 ; 102C: 4C10008B
    r4 = r1 sub 0x8000                         ; 102D: 59308000
    if (r4 ==0) acc+ r1 <- r3                  ; 102E: 6C640014
    r2 = add r7, r1                            ; 102F: F8280000
    *dp0 = r1l                                 ; 1030: 4C800900
    r0l = 0x0                                  ; 1031: 38010000
    *x:0x38c1 = r0l                            ; 1032: 481038C1
    ret                                        ; 1033: 24000000
